# Supabase (client-side — safe to expose, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side only — NEVER expose. Bypasses RLS.)
# Used for the AI agent's data access and inviting bishopric members.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string — used by the migration runner, which runs
# as the `prebuild` step on every build/deploy. Set it in Production only; without
# it the migration step is a harmless no-op.
# Settings → Database → Connection string → Session pooler (IPv4, required for Vercel).
# postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# AI Provider
# The AI assistant is configured in-app under Settings → AI assistant, where you
# can save several model configurations and switch between them (stored in the
# database). These env vars are OPTIONAL — they're only used as a fallback when no
# saved configuration is selected. Leave them empty to manage everything from the UI.
#   AI_PROVIDER: "openai-compat" for OpenRouter / any OpenAI-compatible gateway,
#                "cerebras" for Cerebras, or "deepseek" for DeepSeek.
#   AI_BASE_URL: used for openai-compat and cerebras
#                (OpenRouter default: https://openrouter.ai/api/v1,
#                 Cerebras default:  https://api.cerebras.ai/v1).
#   AI_MODEL:    e.g. openai/gpt-4o-mini (OpenRouter model ids are "vendor/model"),
#                or llama-3.3-70b on Cerebras.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# MCP server (connect the ward tools to Claude as a custom connector)
# The /api/mcp endpoint is disabled until this is set. It signs the OAuth
# client ids, codes and tokens; use a long random value (at least 32 chars),
# e.g. `openssl rand -base64 48`. Changing it disconnects every connected client.
MCP_OAUTH_SECRET=
# Optional: extra OAuth redirect URIs to allow besides Claude's connector
# callback, comma-separated (e.g. http://localhost:6274/oauth/callback for the
# MCP Inspector).
MCP_OAUTH_REDIRECT_URIS=
# Optional: the app's public URL, if it can't be inferred from request headers.
MCP_PUBLIC_URL=
